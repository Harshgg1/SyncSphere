{
  "name": "realtime-chat-redis",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Real-Time Chat Engine with Next.js, Express, Redis Pub/Sub, PostgreSQL & Prisma",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "chat",
    "realtime",
    "redis",
    "websockets",
    "nextjs",
    "express",
    "prisma",
    "postgresql"
  ]
}
